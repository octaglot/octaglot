{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cıvıl",
  "mainBinaryName": "civil",
  "version": "1.0.0",
  "identifier": "com.civil.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cıvıl",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#FFFFFF"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Oyunlaştırılmış İngilizce öğrenme uygulaması",
    "longDescription": "Cıvıl — Türkçe anlatımlı, A1'den B1'e kadar oyunlaştırılmış İngilizce kursu.",
    "resources": ["resources/content.db"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
