{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octaglot",
  "mainBinaryName": "octaglot",
  "version": "1.0.0",
  "identifier": "com.octaglot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Octaglot",
        "width": 1180,
        "height": 820,
        "minWidth": 940,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#15131b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "publisher": "Octaglot App",
    "category": "Education",
    "shortDescription": "Gamified English learning app",
    "longDescription": "Octaglot - a gamified English course from A1 to B1, explained in Turkish.",
    "resources": [
      "resources/content.db"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
