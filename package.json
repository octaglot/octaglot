{
  "name": "octaglot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "content:candidates": "node --max-old-space-size=6144 scripts/build-content.mjs --candidates",
    "content:glosses": "node scripts/fetch-glosses.mjs",
